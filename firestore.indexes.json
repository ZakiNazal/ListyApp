{
  "indexes": [
    {
      "//": "Required by ListRepository.watchLists: arrayContains + orderBy needs a composite index.",
      "collectionGroup": "lists",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "memberUids", "arrayConfig": "CONTAINS" },
        { "fieldPath": "createdAt", "order": "DESCENDING" }
      ]
    },
    {
      "//": "Required by InviteRepository.watchInvites: equality + orderBy on a different field.",
      "collectionGroup": "invites",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "invitedByUid", "order": "ASCENDING" },
        { "fieldPath": "createdAt", "order": "DESCENDING" }
      ]
    },
    {
      "//": "Required by InviteRepository.record: de-duplicates on inviter + phone.",
      "collectionGroup": "invites",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "invitedByUid", "order": "ASCENDING" },
        { "fieldPath": "phone", "order": "ASCENDING" }
      ]
    }
  ],
  "fieldOverrides": []
}
